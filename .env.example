# ──────────────────────────────────────────────────────────────────────────────
# FIX PRO MAX — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env a Git (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
# MongoDB Atlas — Cadena de conexión completa
# Obtén esta URI en: MongoDB Atlas → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/fixpromax?appName=FIXPROMAX

# ── Servidor ──────────────────────────────────────────────────────────────────
# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000
# Entorno: production | development
NODE_ENV=production

# ── Seguridad — Hashing de contraseñas ───────────────────────────────────────
# Salt usado para el hash SHA-256 de contraseñas de usuarios
# ⚠️ NO cambiar en producción — cambiaría el hash de todas las contraseñas existentes
PASSWORD_SALT=cambia_este_valor_por_uno_secreto

# ── Cuenta demo ───────────────────────────────────────────────────────────────
# Contraseña de la cuenta demo pública (demo@fixpromax.app)
DEMO_PASSWORD=cambia_este_valor

# ── Claves de endpoints de administración interna ────────────────────────────
# Protegen rutas de mantenimiento, migración y fixes de datos
# Usar cadenas largas y aleatorias en producción
ADMIN_MIGRATE_KEY=clave_aleatoria_larga_para_migracion
ADMIN_FIX_KEY=clave_aleatoria_larga_para_fixes

# ── WhatsApp / UltraMsg ───────────────────────────────────────────────────────
# Credenciales de UltraMsg para envío de alertas por WhatsApp
# Obtén en: https://ultramsg.com → Tu instancia → API
ULTRAMSG_INSTANCE=instanceXXXXXX
ULTRAMSG_TOKEN=tu_token_de_ultramsg

# Google OAuth 2.0 — obtén en https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://TU_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=tu_google_client_id
GOOGLE_CLIENT_SECRET=tu_google_client_secret
# URL base de la app (sin slash final)
APP_URL=https://fixpromax-erp.onrender.com
